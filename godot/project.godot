; Standing Tank Defense — Godot 4 front-end over the Rust deterministic core.
; Open this folder in Godot 4.3+ AFTER building the gdext lib (see README.md).
config_version=5

[autoload]

ArtTheme="*res://theme.gd"
Profile="*res://profile.gd"
Session="*res://session.gd"
Audio="*res://audio.gd"

[audio]

buses/default_bus_layout="res://audio/default_bus_layout.tres"

[application]

config/name="Standing Tank Defense (preview)"
run/main_scene="res://SkinSelect.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")

[internationalization]

locale/translations=PackedStringArray("res://locale/game_translations.en.translation","res://locale/game_translations.zh_CN.translation")

[physics]

; The sim runs at a fixed 30 Hz — drive one sim tick per physics frame.
common/physics_ticks_per_second=30

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
; canvas_items stretch: the game always renders in the 1280x720 design space
; and scales (aspect-preserving, letterboxed) to the window — text/UI stay
; readable at 4K and 720p alike. Draw code keeps using get_viewport_rect(),
; which now reports the fixed design size, so nothing double-scales.
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[input]

; Custom actions replacing raw keycode matching in every screen. All keyboard
; events bind PHYSICAL keycodes so the layout works on non-QWERTY keyboards
; while keeping the exact default keys TUTORIAL.md documents. Confirm/back and
; the four nav directions also carry basic joypad bindings (A / B / D-pad).

