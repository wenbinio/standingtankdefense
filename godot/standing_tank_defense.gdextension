[configuration]
entry_symbol = "gdext_rust_init"
compatibility_minimum = 4.3
compatibility_maximum = 4.5
reloadable = true

[libraries]
linux.debug.x86_64     = "res://rust/target/debug/libstanding_tank_gdext.so"
linux.release.x86_64   = "res://rust/target/release/libstanding_tank_gdext.so"
macos.debug            = "res://rust/target/debug/libstanding_tank_gdext.dylib"
macos.release          = "res://rust/target/release/libstanding_tank_gdext.dylib"
macos.debug.arm64      = "res://rust/target/debug/libstanding_tank_gdext.dylib"
macos.release.arm64    = "res://rust/target/release/libstanding_tank_gdext.dylib"
windows.debug.x86_64   = "res://rust/target/debug/standing_tank_gdext.dll"
windows.release.x86_64 = "res://rust/target/release/standing_tank_gdext.dll"
