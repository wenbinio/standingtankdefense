-- ============================ 6. RNG stream discipline (§S4) ============================

do
	local s = newState(0xDEADBEEF, 0)
	local rerollBefore = rngHex(s.rng_reroll)
	local spawnBefore = rngHex(s.rng_spawn)
	for _ = 1, 20 do
		Shop.generateOffers(s)
	end
	-- `rng_reroll` is derived and checksummed but NEVER drawn from anywhere in
	-- the Rust sim: reroll cost escalation is pure arithmetic. Any draw here
	-- would desynchronize the checksum on the very first reroll.
	check("generateOffers never touches rng_reroll", rngHex(s.rng_reroll) == rerollBefore)
	check("generateOffers never touches rng_spawn", rngHex(s.rng_spawn) == spawnBefore)
	if oracleDoc ~= nil then
		check(
			"rng_reroll matches the Rust's untouched state",
			rerollBefore == oracleDoc.facts.rng_reroll_untouched_state
		)
	end

	local w = newState(0xDEADBEEF, 0)
	local shopBefore = rngHex(w.rng_shop)
	for t = 0, 200 do
		spawnAt(w, t)
	end
	check("Waves.spawn never touches rng_shop", rngHex(w.rng_shop) == shopBefore)

	-- The boss spawn itself draws NOTHING (it uses SPAWN_RING[0] directly), so
	-- the escort's ring picks at the boss tick land on the same words they would
	-- have had without a boss. Verified against the boss-tick oracle row above;
	-- restated here as an explicit count: boss tick draws == escort entries that
	-- fire, not escort entries + 1.
	local later = BOSS_SPAWN_TICK + 180 -- lcm(4, 12, 15, 45): all four escorts fire
	local b1 = newState(0x12345678, 0)
	local b2 = newState(0x12345678, 0)
	spawnAt(b1, BOSS_SPAWN_TICK)
	spawnAt(b2, later)
	local fires = 0
	for _, ws in Content.BOSS_ESCORT do
		if ws.cadence_ticks ~= 0 and BOSS_SPAWN_TICK % ws.cadence_ticks == 0 then
			fires += 1
		end
	end
	local firesLater = 0
	for _, ws in Content.BOSS_ESCORT do
		if ws.cadence_ticks ~= 0 and later % ws.cadence_ticks == 0 then
			firesLater += 1
		end
	end
	eqNum("all four escort entries fire at the chosen tick", firesLater, #Content.BOSS_ESCORT)
	eqNum("boss tick spawns = boss + escort entries that fire", #b1.enemies, fires + 1)
	eqNum("escort-only tick spawns = escort entries that fire", #b2.enemies, firesLater)
end

-- ============================ 7. reroll: stream advances once per success ============================
-- LOCAL MIRROR of `input.rs::apply(Input::Reroll)`. `Input.luau` owns this;
-- it is reproduced here only to test the property `Shop.luau` owns.
do
	local REROLL_COST_STEP = 100

	local function reroll(s)
		if s.economy.rerolls_remaining > 0 then
			s.economy.rerolls_remaining -= 1
			Shop.generateOffers(s)
		elseif s.economy.gold >= s.economy.reroll_cost then
			s.economy.gold -= s.economy.reroll_cost
			Shop.generateOffers(s)
			s.economy.reroll_cost += REROLL_COST_STEP
		end
	end

	local s = newState(0xDEADBEEF, 0)
	s.economy.gold = 1000
	eqNum("starting free rerolls", s.economy.rerolls_remaining, 5)
	eqNum("starting reroll cost", s.economy.reroll_cost, 100)

	-- Free rerolls first: no gold charged, cost unchanged, one generation each.
	for i = 1, 5 do
		reroll(s)
		eqNum("free reroll " .. i .. ": rerolls_remaining", s.economy.rerolls_remaining, 5 - i)
		eqNum("free reroll " .. i .. ": gold unchanged", s.economy.gold, 1000)
		eqNum("free reroll " .. i .. ": cost unchanged", s.economy.reroll_cost, 100)
		eqNum("free reroll " .. i .. ": one generation", s.shop.shop_seq, i)
	end

	-- Then escalating gold: 100, 200, ...
	reroll(s)
	eqNum("paid reroll 1: gold", s.economy.gold, 900)
	eqNum("paid reroll 1: cost escalates", s.economy.reroll_cost, 200)
	reroll(s)
	eqNum("paid reroll 2: gold", s.economy.gold, 700)
	eqNum("paid reroll 2: cost escalates", s.economy.reroll_cost, 300)
	eqNum("seven generations so far", s.shop.shop_seq, 7)

	-- Broke and out of free rerolls → IGNORED. The stream must not advance:
	-- this is the save-scum guard — a rejected reroll may not consume words.
	s.economy.gold = 50
	local frozen = rngHex(s.rng_shop)
	local seq = s.shop.shop_seq
	local firstDef = s.shop.offers[1].def
	reroll(s)
	eqNum("ignored reroll: gold unchanged", s.economy.gold, 50)
	eqNum("ignored reroll: no regeneration", s.shop.shop_seq, seq)
	eqNum("ignored reroll: offers unchanged", s.shop.offers[1].def, firstDef)
	check("ignored reroll: rng_shop frozen", rngHex(s.rng_shop) == frozen)

	-- The 7 generations the reroll path produced are exactly generations 1..7 of
	-- the plain offer stream — rerolling is not a different stream.
	local plain = newState(0xDEADBEEF, 0)
	local same = true
	for _ = 1, 7 do
		Shop.generateOffers(plain)
	end
	if rngHex(plain.rng_shop) ~= rngHex(s.rng_shop) then
		same = false
	end
	for k = 1, 8 do
		if plain.shop.offers[k].def ~= s.shop.offers[k].def then
			same = false
		end
	end
	check("reroll advances the SAME offer stream, once per success", same)
end

-- ============================ 8. the stateful offer machinery ============================
do
	-- `docs/02` §2.8 says the offer stream is stateful and order-dependent so it
	-- cannot be save-scummed. In the IMPLEMENTED Rust that property holds in a
	-- specific, narrower way: the stream is advanced ONLY by `generate_offers`,
	-- and `pending_perk` (Multiplication Gems / Black Market voucher) changes the
	-- next matching PURCHASE — free, or +N free copies — not the next DRAW.
	-- Pinning that here so a future "rarity-weighted / pool-restricted draw"
	-- change is a deliberate, visible break rather than a silent one.
	local a = newState(777, 1)
	local b = newState(777, 1)
	for i = 1, 6 do
		Shop.generateOffers(a)
		-- Arm, match and consume perks, move gold around, buy things — none of it
		-- may perturb the offer stream.
		b.pending_perk = { rarity = (i % 3 == 0) and 255 or 0, extra_copies = i, free = i % 2 == 0 }
		b.economy.gold += 137 * i
		Shop.generateOffers(b)
		b.pending_perk = nil
	end
	local same = rngHex(a.rng_shop) == rngHex(b.rng_shop)
	for k = 1, 8 do
		if a.shop.offers[k].def ~= b.shop.offers[k].def or a.shop.offers[k].kind ~= b.shop.offers[k].kind then
			same = false
		end
	end
	check("offer stream is advanced ONLY by generateOffers", same)

	-- The catalog carries the meta items the perk machine needs (`state.rs`
	-- `buy_modifier`: tag 24 GrantDuplicator(rarity, copies), 25 GrantVoucher
	-- (rarity), 26 GrantGold). `input.rs` reads them; assert they exist so a
	-- content change that drops them fails here rather than silently.
	local dup, voucher, gold = nil, nil, nil
	for i, m in Content.MODIFIERS do
		for _, e in m.effects do
			if e.tag == 24 and dup == nil then
				dup = { idx = i - 1, rarity = e.a, copies = e.b }
			elseif e.tag == 25 and voucher == nil then
				voucher = { idx = i - 1, rarity = e.a }
			elseif e.tag == 26 and gold == nil then
				gold = { idx = i - 1, amount = e.a }
			end
		end
	end
	check("catalog has a Multiplication-Gems style duplicator", dup ~= nil)
	check("catalog has a Black-Market style voucher", voucher ~= nil)
	check("catalog has a Magic-Treasure style gold grant", gold ~= nil)
	if dup ~= nil then
		check("duplicator grants at least one extra copy", dup.copies >= 1)
	end
end

-- ============================ 9. catalog index base ============================
do
	-- `Content.luau`'s index base is not pinned by SIM-SPEC §S2, and getting it
	-- wrong is silent and fatal: `Rng.below(rng_shop, #WEAPONS)` over a 0-based
	-- table draws from 85 instead of 86 and desynchronizes `rng_shop` forever.
	-- Both modules detect the base and cross-check it against `constants.num_*`;
	-- prove the adaptation is behavior-NEUTRAL by running both wirings.
	local function toZeroBased(t)
		local out = {}
		for i, v in t do
			out[i - 1] = v
		end
		return out
	end
	local Zero = {}
	for k, v in Content do
		Zero[k] = v
	end
	Zero.WEAPONS = toZeroBased(Content.WEAPONS)
	Zero.MODIFIERS = toZeroBased(Content.MODIFIERS)
	Zero.ENEMIES = toZeroBased(Content.ENEMIES)
	Zero.SPAWN_RING = toZeroBased(Content.SPAWN_RING)
	Zero.WAVE_M0 = toZeroBased(Content.WAVE_M0)
	Zero.BOSS_ESCORT = toZeroBased(Content.BOSS_ESCORT)

	local one = newState(0xDEADBEEF, 0)
	Shop.generateOffers(one)
	local oneW = newState(0x12345678, 0)
	for t = 0, 120 do
		spawnAt(oneW, t)
	end

	Shop.setContent(Zero)
	Waves.setContent(Zero)
	local zero = newState(0xDEADBEEF, 0)
	Shop.generateOffers(zero)
	local zeroW = newState(0x12345678, 0)
	for t = 0, 120 do
		spawnAt(zeroW, t)
	end

	check("0-based catalog: same rng_shop", rngHex(zero.rng_shop) == rngHex(one.rng_shop))
	local same = true
	for k = 1, 8 do
		if zero.shop.offers[k].def ~= one.shop.offers[k].def
			or zero.shop.offers[k].cost ~= one.shop.offers[k].cost
		then
			same = false
		end
	end
	check("0-based catalog: same offers", same)
	check("0-based catalog: same rng_spawn", rngHex(zeroW.rng_spawn) == rngHex(oneW.rng_spawn))
	eqNum("0-based catalog: same spawn count", #zeroW.enemies, #oneW.enemies)
	local sameSpawn = #zeroW.enemies == #oneW.enemies
	for k = 1, math.min(#zeroW.enemies, #oneW.enemies) do
		if zeroW.enemies[k].def ~= oneW.enemies[k].def or zeroW.enemies[k].hp ~= oneW.enemies[k].hp then
			sameSpawn = false
		end
	end
	check("0-based catalog: same spawns", sameSpawn)

	-- A catalog whose length disagrees with `constants.num_*` must fail LOUDLY,
	-- not draw over the wrong range.
	local Bad = {}
	for k, v in Content do
		Bad[k] = v
	end
	local truncated = {}
	for i = 1, #Content.WEAPONS - 1 do
		truncated[i] = Content.WEAPONS[i]
	end
	Bad.WEAPONS = truncated
	Shop.setContent(Bad)
	local ok = pcall(function()
		Shop.generateOffers(newState(1, 0))
	end)
	check("a catalog/num_* mismatch errors instead of desyncing", not ok)

	Shop.setContent(Content)
	Waves.setContent(Content)
end

-- ============================ report ============================

print(string.format("waves_test: %d passed, %d failed", passed, failed))
if failed > 0 then
	for _, f in firstFailures do
		print("  FAIL " .. f)
	end
	error("waves_test: " .. failed .. " assertion(s) failed", 0)
end
