-- ============================ harness ============================

local passed, failed = 0, 0
local firstFailures = {}

local function check(name, cond, detail)
	if cond then
		passed += 1
	else
		failed += 1
		if #firstFailures < 25 then
			table.insert(firstFailures, name .. (detail and (" — " .. detail) or ""))
		end
	end
end

local function eqNum(name, got, want)
	check(name, got == want, string.format("got %s, want %s", tostring(got), tostring(want)))
end

-- ============================ input ============================

-- The real catalog. `Content.luau` self-loads its embedded `content.json`, so
-- this test needs no argv at all.
local Content = require("../src/shared/Content")
Waves.setContent(Content)
Shop.setContent(Content)

local STEAM = Content.TIMELINE.steam
local BOSS_SPAWN_TICK = STEAM.boss_spawn_tick
local RAMP_INTERVAL = STEAM.ramp_interval
local GENTLE_TICKS = STEAM.gentle_ticks
local EARLY_GRUNT_CADENCE = Content.CONSTANTS.early_grunt_cadence
local BOSS = Content.BOSS

--- `u32::MAX` — `ArenaState::new`'s pre-first-round `round` sentinel
--- (`state.rs`), which `shop::rarity_weights` maps onto the opening table.
local U32_MAX = 4294967295

--- `Purpose` (`ids.rs`) — values are stable on the wire/checksum.
local PURPOSE = { Spawn = 0, Targeting = 1, Shop = 2, Reroll = 3, Proc = 4 }

--- The subset of `ArenaState` these two modules read or write. `next_entity_id`
--- starts at 2 because `ArenaState::new` allocates id 1 for the starting Bow.
--- `round` is REQUIRED: `Shop.rarityWeights` interpolates the rarity table
--- against it, so a state without it errors inside `math.min`.
local function newState(seed, pid, round)
	return {
		tick = 0,
		round = round or 0,
		enemies = {},
		next_entity_id = 2,
		shop = { offers = {}, shop_seq = 0 },
		economy = { gold = 500, rerolls_remaining = 5, reroll_cost = 100 },
		pending_perk = nil,
		rng_spawn = Rng.derive(seed, pid, PURPOSE.Spawn, 0),
		rng_shop = Rng.derive(seed, pid, PURPOSE.Shop, 0),
		rng_reroll = Rng.derive(seed, pid, PURPOSE.Reroll, 0),
	}
end

local function rngHex(r)
	return string.sub(Rng.toHex(Rng.state(r)), 3) -- drop the "0x"
end

--- One tick of phase 5 in isolation, with the enemy list cleared first (which
--- is exactly what the oracle generator does), so `s.enemies` afterwards is this
--- tick's spawn list.
local function spawnAt(s, tick)
	s.tick = tick
	table.clear(s.enemies)
	Waves.spawn(s)
end

-- ============================ 1. enemy_hp_mult ============================

for _, e in ORACLE_HP_MULT do
	local tick, want = e[1], e[2]
	eqNum("hp_mult@" .. tick, Fixed.raw(Waves.enemyHpMult(tick)), want)
end

-- The curve's SHAPE, transcribed from `waves.rs::hp_curve_is_a_3min_stepped_ramp`.
-- `docs/11` balance pass: the endpoint moved ×5.56 → ≈ ×17.7, and the multiplier
-- is no longer the primary difficulty lever (the wave schedule is) — it is kept
-- shallow enough that the last two intervals are not a cliff.
do
	eqNum("ramp interval is 5400 (steam)", RAMP_INTERVAL, 3 * 60 * Content.CONSTANTS.tick_hz)
	check("m(0) == ONE", Fixed.eq(Waves.enemyHpMult(0), Fixed.ONE))

	-- (1) Monotonic non-decreasing across the whole curve (no downward steps).
	local prev = Fixed.ONE
	local dipped = nil
	local t = 0
	while t <= BOSS_SPAWN_TICK + 600 do
		local cur = Waves.enemyHpMult(t)
		if Fixed.lt(cur, prev) and dipped == nil then
			dipped = t
		end
		prev = cur
		t += 30 -- sample once per second — fast and dense enough
	end
	check("curve never dips", dipped == nil, dipped and ("dipped at tick " .. dipped) or nil)

	-- (2) Exact post-step multipliers at each 3-min boundary (×10000), compounding
	--     `G·W·J ≈ ×1.3331` per interval up to ≈ ×17.7 at the boss. The boss tier
	--     is `base(10)`; the boss phase holds it.
	for _, p in ORACLE_HP_POST do
		eqNum(
			"post-step mult at " .. p[1],
			Fixed.toInt(Fixed.scaleI64(Waves.enemyHpMult(p[1]), 10000)),
			p[2]
		)
	end
	eqNum(
		"the boss tier is the k=10 post-step tier",
		Fixed.raw(Waves.enemyHpMult(BOSS_SPAWN_TICK)),
		Fixed.raw(Waves.enemyHpMult(STEAM.ramp_intervals_to_boss * RAMP_INTERVAL))
	)
	check(
		"boss phase holds the endpoint",
		Fixed.eq(Waves.enemyHpMult(BOSS_SPAWN_TICK + 5000), Waves.enemyHpMult(BOSS_SPAWN_TICK))
	)

	-- (3) Within an interval: a gentle region, then a STEEPER warning region.
	--     Verify on the k=1 interval [RAMP_INTERVAL, 2*RAMP_INTERVAL).
	local lo = RAMP_INTERVAL
	local warnStart = lo + GENTLE_TICKS
	local function m10e6(x)
		return Fixed.toInt(Fixed.scaleI64(Waves.enemyHpMult(x), 1000000))
	end
	local gentleSlope = (m10e6(warnStart - 100) - m10e6(warnStart - 200)) // 100
	local warnSlope = (m10e6(warnStart + 100) - m10e6(warnStart)) // 100
	check("gentle region must rise", gentleSlope > 0)
	check("warning slope perceptibly steeper", warnSlope >= gentleSlope * 3)

	-- (4) The boundary STEP dwarfs any single warning tick, and is exactly `J` —
	--     read off `content.json` (`ramp_jump_num/den`) rather than pinned, so a
	--     retune of `RAMP_JUMP` retunes this assertion with it.
	local preStep = Waves.enemyHpMult(lo + RAMP_INTERVAL - 1)
	local postStep = Waves.enemyHpMult(lo + RAMP_INTERVAL)
	local step = m10e6(lo + RAMP_INTERVAL) - m10e6(lo + RAMP_INTERVAL - 1)
	check("boundary step dwarfs a warning tick", step > warnSlope * 50)
	eqNum(
		"boundary step is exactly J (content.json ramp_jump)",
		Fixed.toInt(Fixed.scaleI64(postStep, 1000)),
		Fixed.toInt(
			Fixed.scaleI64(
				Fixed.mul(preStep, Fixed.fromRatio(Content.RAMP_JUMP_NUM, Content.RAMP_JUMP_DEN)),
				1000
			)
		)
	)
	check("J is a real step up", Content.RAMP_JUMP_NUM > Content.RAMP_JUMP_DEN)
end

-- The Roblox timeline is reachable as a PARAMETER (never hardcoded), and does
-- not disturb the Steam default the oracle vectors are generated against. Both
-- the tick and the interval are DERIVED from the shipped `tick_scale_*` ratio,
-- so an F1 rescale cannot silently disagree with this test.
do
	local rbx = Content.TIMELINE.roblox
	local num, den = rbx.tick_scale_num, rbx.tick_scale_den
	eqNum(
		"roblox boss tick is the F1 rescale of steam's",
		rbx.boss_spawn_tick,
		BOSS_SPAWN_TICK * num // den
	)
	eqNum(
		"roblox ramp interval is the F1 rescale of steam's",
		rbx.ramp_interval,
		RAMP_INTERVAL * num // den
	)
	eqNum(
		"both timelines keep ramp_intervals_to_boss",
		rbx.ramp_intervals_to_boss,
		STEAM.ramp_intervals_to_boss
	)
	eqNum(
		"roblox curve reaches the SAME endpoint (rescale, not rebalance)",
		Fixed.toInt(Fixed.scaleI64(Waves.enemyHpMult(rbx.boss_spawn_tick, rbx), 10000)),
		Fixed.toInt(Fixed.scaleI64(Waves.enemyHpMult(BOSS_SPAWN_TICK, STEAM), 10000))
	)
	check(
		"default timeline is steam (the oracle's)",
		Fixed.eq(Waves.enemyHpMult(9000), Waves.enemyHpMult(9000, STEAM))
	)
end

-- ============================ 2. spawn, vs the oracle ============================

--- Replay every block of one `(seed, pid)` stream on a SINGLE state. `rng_spawn`
--- after tick N depends on every preceding tick, so the gaps between blocks are
--- fast-forwarded honestly; walking one state forward is what keeps a late block
--- (the boss tick) affordable.
local function runSpawnRun(run, label)
	local s = newState(run.seed, run.pid, 0)
	local nextTick = 0
	for _, block in run.blocks do
		for t = nextTick, block.start - 1 do
			spawnAt(s, t)
		end
		for i, want in block.ticks do
			local tick = block.start + i - 1
			spawnAt(s, tick)
			local tag = string.format("%s t=%d", label, tick)
			local gotHex = rngHex(s.rng_spawn)
			if gotHex ~= want[1] then
				check(tag .. " rng_spawn", false, "got " .. gotHex .. ", want " .. want[1])
				return -- once the stream diverges every later tick is noise
			end
			passed += 1
			eqNum(tag .. " next_entity_id", s.next_entity_id, want[2])
			local n = (#want - 2) // 3
			eqNum(tag .. " spawn count", #s.enemies, n)
			for k = 1, math.min(n, #s.enemies) do
				local e = s.enemies[k]
				eqNum(tag .. " spawn" .. k .. ".id", e.id, want[2 + (k - 1) * 3 + 1])
				eqNum(tag .. " spawn" .. k .. ".def", e.def, want[2 + (k - 1) * 3 + 2])
				eqNum(tag .. " spawn" .. k .. ".hp", e.hp, want[2 + (k - 1) * 3 + 3])
			end
		end
		nextTick = block.start + #block.ticks
	end
end

for i, run in ORACLE_SPAWN do
	runSpawnRun(run, "spawn#" .. i)
end

-- ============================ 3. spawn, structural (waves.rs tests) ============================

--- `waves.rs::spawn`'s gating arithmetic, evaluated against `content.json`: how
--- many enemies MUST spawn on `tick`. Derived, never pinned — the wave table is
--- regenerated from the Rust on every balance pass, and the `rng_spawn` oracle
--- above already pins the exact behaviour. This exists so the gate/cadence
--- assertions below survive a retune instead of encoding one catalog snapshot.
local function expectedSpawnCount(tick: number): number
	local n = 0
	if tick == BOSS_SPAWN_TICK then
		n += 1 -- the boss itself, at SPAWN_RING[0], no rng draw
	end
	if tick >= BOSS_SPAWN_TICK then
		for _, ws in Content.BOSS_ESCORT do
			if ws.cadence_ticks ~= 0 and tick % ws.cadence_ticks == 0 then
				n += 1
			end
		end
		return n
	end
	for _, ws in Content.WAVE_M0 do
		if ws.cadence_ticks ~= 0 and tick >= ws.start_tick and tick % ws.cadence_ticks == 0 then
			n += 1
		end
	end
	return n
end

do
	-- The catalog's shape, as `waves.rs` asserts it. All read off `content.json`.
	local ungated = 0
	local firstUngated = nil
	for _, w in Content.WAVE_M0 do
		if w.start_tick == 0 then
			ungated += 1
			if firstUngated == nil then
				firstUngated = w
			end
		end
	end
	eqNum("exactly one ungated wave entry", ungated, 1)
	assert(firstUngated ~= nil, "no ungated wave entry in the catalog")
	local floorEntry = firstUngated :: any
	eqNum(
		"the ungated entry is the swarm floor at EARLY_GRUNT_CADENCE",
		floorEntry.cadence_ticks,
		EARLY_GRUNT_CADENCE
	)

	-- `docs/10` F1: every gate must divide by the F1 rescale denominator, or a
	-- gate lands a tick early/late on the Roblox timeline.
	local rbx = Content.TIMELINE.roblox
	local scaleDen = rbx.tick_scale_den // rbx.tick_scale_num
	local badGate, zeroCadence = nil, false
	for _, list in { Content.WAVE_M0, Content.BOSS_ESCORT } do
		for _, w in list do
			if w.start_tick % scaleDen ~= 0 and badGate == nil then
				badGate = w.start_tick
			end
			if w.cadence_ticks <= 0 then
				zeroCadence = true
			end
		end
	end
	check("every wave gate rescales exactly onto the Roblox timeline", badGate == nil,
		badGate and ("gate " .. badGate .. " does not divide by " .. scaleDen) or nil)
	check("no wave entry has a zero cadence (it would never spawn)", not zeroCadence)
	eqNum("the boss tick is a ramp boundary", BOSS_SPAWN_TICK % RAMP_INTERVAL, 0)
	eqNum(
		"F1 keeps ramp_intervals_to_boss at 10 on both timelines",
		BOSS_SPAWN_TICK // RAMP_INTERVAL,
		STEAM.ramp_intervals_to_boss
	)

	-- One swarm-cadence tick inside the first six seconds fires exactly the
	-- ungated floor entry and nothing else (`spawns_on_cadence_for_first_wave_entry`).
	local g = EARLY_GRUNT_CADENCE
	eqNum("catalog says one spawn at the swarm cadence", expectedSpawnCount(g), 1)
	local s = newState(0x12345678, 0, 0)
	spawnAt(s, g)
	eqNum("cadence: exactly one enemy (the swarm floor)", #s.enemies, 1)
	eqNum("cadence: def is the floor entry's enemy", s.enemies[1].def, floorEntry.enemy)
	-- hp from EnemyDef::base_hp, unscaled at ×1 this early.
	eqNum(
		"cadence: hp is base_hp (unscaled this early)",
		s.enemies[1].hp,
		Content.ENEMIES[floorEntry.enemy + 1].base_hp
	)

	-- Nothing spawns off-cadence — checked across the whole first cadence window
	-- rather than at one hand-picked tick (`no_spawn_off_cadence`).
	local offCadenceLeak = nil
	for t = 1, g - 1 do
		if expectedSpawnCount(t) == 0 then
			local o = newState(0x12345678, 0, 0)
			spawnAt(o, t)
			if #o.enemies ~= 0 and offCadenceLeak == nil then
				offCadenceLeak = t
			end
		end
	end
	check("nothing spawns off-cadence", offCadenceLeak == nil,
		offCadenceLeak and ("tick " .. offCadenceLeak .. " spawned") or nil)

	-- Tick 0 is divisible by every cadence, but only ONE entry is ungated: a
	-- fresh tank meets its first shop before its first bruiser
	-- (`tick_zero_spawns_only_the_ungated_swarm_floor`).
	s = newState(0x12345678, 0, 0)
	spawnAt(s, 0)
	eqNum("tick 0 spawns only the ungated swarm floor", #s.enemies, 1)
	eqNum("tick 0 spawn count matches the catalog", #s.enemies, expectedSpawnCount(0))
	eqNum("tick 0 def is the floor entry's enemy", s.enemies[1].def, floorEntry.enemy)
	eqNum(
		"tick 0 hp is base_hp",
		s.enemies[1].hp,
		Content.ENEMIES[floorEntry.enemy + 1].base_hp
	)

	-- Ids are allocated in order on a tick where SEVERAL entries fire. One minute
	-- opens the bruiser gate and is a multiple of several cadences
	-- (`ids_are_monotonic_and_ordered`).
	local multi = 60 * Content.CONSTANTS.tick_hz
	s = newState(0x12345678, 0, 0)
	spawnAt(s, multi)
	check("multi-spawn tick has several spawns", #s.enemies >= 2, "#enemies = " .. #s.enemies)
	eqNum("multi-spawn tick count matches the catalog", #s.enemies, expectedSpawnCount(multi))
	local ordered = true
	for k = 2, #s.enemies do
		if not (s.enemies[k - 1].id < s.enemies[k].id) then
			ordered = false
		end
	end
	check("ids allocated in order", ordered)

	-- The spawn must be exactly one of the precomputed ring positions, and not
	-- the origin (sanity that a ring entry was used).
	s = newState(0x12345678, 0, 0)
	spawnAt(s, g)
	local pos = s.enemies[1].pos
	local onRing = false
	for _, r in Content.SPAWN_RING do
		if Fixed.eq(pos.x, r.x) and Fixed.eq(pos.y, r.y) then
			onRing = true
		end
	end
	check("enemy spawns on the SPAWN_RING", onRing)
	check(
		"spawn is not the origin",
		not (Fixed.eq(pos.x, Fixed.ZERO) and Fixed.eq(pos.y, Fixed.ZERO))
	)
end

do
	-- Wave throughput RISES at every 3-min boundary — the `docs/11` fix for the
	-- 6-to-20-minute plateau (`wave_schedule_escalates_monotonically_after_the_grace_period`).
	-- Purely a function of `content.json`, integer-only like the sim itself.
	local function tput(tick)
		local sum = 0
		for _, w in Content.WAVE_M0 do
			if tick >= w.start_tick and w.cadence_ticks > 0 then
				sum += Content.ENEMIES[w.enemy + 1].base_hp * 1000 // w.cadence_ticks
			end
		end
		return sum
	end
	local first = tput(RAMP_INTERVAL)
	local prev = first
	local plateau = nil
	local k = 2
	while k * RAMP_INTERVAL < BOSS_SPAWN_TICK do
		local cur = tput(k * RAMP_INTERVAL)
		if cur <= prev and plateau == nil then
			plateau = k
		end
		prev = cur
		k += 1
	end
	check("wave throughput rises at every 3-min boundary", plateau == nil,
		plateau and ("plateau at k=" .. plateau) or nil)
	check("escalation is substantial, not cosmetic (>=10x)", prev >= first * 10,
		"3 min " .. first .. " -> last pre-boss " .. prev)
end

do
	-- The Doomduck is gated; before its start_tick it must not spawn even on a
	-- tick divisible by its cadence (`gated_entries_dormant_until_start_tick`).
	local peon = nil
	for i, e in Content.ENEMIES do
		if e.name == "Doomduck" and peon == nil then
			peon = i - 1
		end
	end
	assert(peon ~= nil, "Doomduck missing from the enemy catalog")
	local peonDef = peon :: any
	local ws = nil
	for _, w in Content.WAVE_M0 do
		if w.enemy == peonDef and ws == nil then
			ws = w
		end
	end
	assert(ws ~= nil, "no wave entry for the Doomduck")
	local entry = ws :: any
	check("peon entry is gated", entry.start_tick > 0)
	local pre = (entry.start_tick // entry.cadence_ticks) * entry.cadence_ticks
	if pre >= entry.start_tick then
		pre -= entry.cadence_ticks
	end
	eqNum("the chosen tick is on the peon's cadence", pre % entry.cadence_ticks, 0)
	check("the chosen tick is before the gate", pre < entry.start_tick)
	local s = newState(0x12345678, 0, 0)
	spawnAt(s, pre)
	local n = 0
	for _, e in s.enemies do
		if e.def == peonDef then
			n += 1
		end
	end
	eqNum("gated peon must not spawn before its start_tick", n, 0)

	-- …and it DOES spawn once the gate is open, on the first cadence tick at or
	-- after it. (A gate that never opens would pass the assertion above.)
	local post = pre
	while post < entry.start_tick do
		post += entry.cadence_ticks
	end
	local t = newState(0x12345678, 0, 0)
	spawnAt(t, post)
	local m = 0
	for _, e in t.enemies do
		if e.def == peonDef then
			m += 1
		end
	end
	check("the peon gate does open", m >= 1, "no peon at tick " .. post)
end

do
	-- At the boss tick the boss spawns exactly once; the BOSS_ESCORT swarm also
	-- spawns this tick (all escort cadences divide the boss tick).
	local s = newState(0x12345678, 0, 0)
	spawnAt(s, BOSS_SPAWN_TICK)
	local bosses, sawBoss = 0, false
	for _, e in s.enemies do
		if Content.ENEMIES[e.def + 1].boss then
			bosses += 1
		end
		if e.def == BOSS then
			sawBoss = true
		end
	end
	eqNum("exactly one boss spawns at the boss tick", bosses, 1)
	check("the boss is among the spawns", sawBoss)
	check("the boss spawns FIRST (id order)", s.enemies[1].def == BOSS)
	eqNum(
		"the boss uses its fixed HP (no scaling)",
		s.enemies[1].hp,
		Content.ENEMIES[BOSS + 1].base_hp
	)
	eqNum("boss tick spawn count matches the catalog", #s.enemies, expectedSpawnCount(BOSS_SPAWN_TICK))

	-- The boss spawns ONLY once: at a later boss-phase tick no second boss
	-- appears, but the escort swarm keeps coming.
	local escortTick = BOSS_SPAWN_TICK + Content.BOSS_ESCORT[1].cadence_ticks
	spawnAt(s, escortTick)
	local anyBoss = false
	for _, e in s.enemies do
		if Content.ENEMIES[e.def + 1].boss then
			anyBoss = true
		end
	end
	check("the boss spawns once, not again during the boss phase", not anyBoss)
	check("the escort swarm keeps spawning in the boss phase", #s.enemies > 0)
	eqNum("escort-only tick count matches the catalog", #s.enemies, expectedSpawnCount(escortTick))
end

do
	-- Walk the whole pre-boss timeline; every catalog enemy except the boss must
	-- appear via the escalating WAVE_M0 schedule.
	local s = newState(0x12345678, 0, 0)
	local seen = {}
	for t = 0, BOSS_SPAWN_TICK - 1 do
		spawnAt(s, t)
		for _, e in s.enemies do
			seen[e.def] = true
		end
	end
	for idx, def in Content.ENEMIES do
		if not def.boss then
			check(
				"roster enemy spawns over the match: " .. def.name,
				seen[idx - 1] == true,
				"def " .. (idx - 1) .. " never spawned in WAVE_M0"
			)
		end
	end
end

do
	-- Same seed/tick → identical spawn, and the stream advances identically.
	local a, b = newState(0x12345678, 0, 0), newState(0x12345678, 0, 0)
	spawnAt(a, 15)
	spawnAt(b, 15)
	eqNum("determinism: same spawn count", #a.enemies, #b.enemies)
	check("determinism: rng_spawn states agree", rngHex(a.rng_spawn) == rngHex(b.rng_spawn))
	local c, d = newState(0x12345678, 0, 0), newState(0x12345678, 0, 0)
	local pc, pd = {}, {}
	for _, t in { 15, 30, 45, 60, 75 } do
		spawnAt(c, t)
		spawnAt(d, t)
		for _, e in c.enemies do
			table.insert(pc, Fixed.toDecimal(e.pos.x) .. "," .. Fixed.toDecimal(e.pos.y))
		end
		for _, e in d.enemies do
			table.insert(pd, Fixed.toDecimal(e.pos.x) .. "," .. Fixed.toDecimal(e.pos.y))
		end
	end
	check("determinism: ring picks reproduce", table.concat(pc, ";") == table.concat(pd, ";"))
end

do
	-- The ring is copied per spawn, never aliased: mutating an enemy's position
	-- must not corrupt the shared SPAWN_RING for later spawns.
	local s = newState(0x12345678, 0, 0)
	spawnAt(s, 0)
	local first = s.enemies[1]
	local before = Fixed.toDecimal(first.pos.x)
	first.pos.x = Fixed.ZERO
	local s2 = newState(0x12345678, 0, 0)
	spawnAt(s2, 0)
	check("ring positions are copied, not aliased", Fixed.toDecimal(s2.enemies[1].pos.x) == before)
end

-- ============================ 4. shop, vs the oracle ============================

local function runShopOracle(run, label)
	local s = newState(run.seed, run.pid, run.round)
	for i, want in run.sets do
		Shop.generateOffers(s)
		local tag = string.format("%s r=%d gen=%d", label, run.round, i)
		eqNum(tag .. " shop_seq", s.shop.shop_seq, i)
		local gotHex = rngHex(s.rng_shop)
		if gotHex ~= want[1] then
			check(tag .. " rng_shop", false, "got " .. gotHex .. ", want " .. want[1])
			return
		end
		passed += 1
		eqNum(tag .. " offer count", #s.shop.offers, Shop.OFFER_SLOTS)
		for k = 1, Shop.OFFER_SLOTS do
			local o = s.shop.offers[k]
			eqNum(tag .. " offer" .. k .. ".kind", o.kind, want[1 + (k - 1) * 3 + 1])
			eqNum(tag .. " offer" .. k .. ".def", o.def, want[1 + (k - 1) * 3 + 2])
			eqNum(tag .. " offer" .. k .. ".cost", o.cost, want[1 + (k - 1) * 3 + 3])
		end
	end
end

for i, run in ORACLE_SHOP do
	runShopOracle(run, "shop#" .. i)
end

-- ============================ 5. shop, structural (shop.rs tests) ============================

do
	local s = newState(0xDEADBEEF, 0, 0)
	Shop.generateOffers(s)
	eqNum("produces the configured slot count", #s.shop.offers, 8)
	eqNum("weapon slots", Shop.WEAPON_SLOTS, 4)
	for k = 1, 8 do
		local o = s.shop.offers[k]
		-- A FIXED layout: the first 4 are always weapons, the rest modifiers.
		-- Rarity weighting changes WHAT is drawn, never the layout.
		local wantKind = if k <= Shop.WEAPON_SLOTS then Shop.OfferKind.Weapon else Shop.OfferKind.Modifier
		eqNum("slot " .. k .. " kind", o.kind, wantKind)
		local cat = if o.kind == Shop.OfferKind.Weapon then Content.WEAPONS else Content.MODIFIERS
		check("slot " .. k .. " def in range", o.def >= 0 and o.def < #cat)
		eqNum("slot " .. k .. " cost matches its catalog def", o.cost, cat[o.def + 1].cost)
	end

	-- The layout is unchanged at a LATE round too (`slot_layout_is_unchanged`).
	local late = newState(4242, 0, 25)
	Shop.generateOffers(late)
	local layoutOk = true
	for k = 1, 8 do
		local wantKind = if k <= Shop.WEAPON_SLOTS then Shop.OfferKind.Weapon else Shop.OfferKind.Modifier
		if late.shop.offers[k].kind ~= wantKind then
			layoutOk = false
		end
	end
	check("slot layout is unchanged at a late round", layoutOk)

	-- shop_seq increments once per generation.
	local before = s.shop.shop_seq
	Shop.generateOffers(s)
	eqNum("increments shop_seq", s.shop.shop_seq, before + 1)
	Shop.generateOffers(s)
	eqNum("increments shop_seq again", s.shop.shop_seq, before + 2)

	-- Previous offers are REPLACED, not appended to.
	s.shop.offers = { { kind = Shop.OfferKind.Weapon, def = 99, cost = -1 } }
	Shop.generateOffers(s)
	eqNum("replaces previous offers", #s.shop.offers, 8)
	local stale = false
	for _, o in s.shop.offers do
		if o.def == 99 and o.cost == -1 then
			stale = true
		end
	end
	check("no stale offer survives", not stale)

	-- Both kinds appear across enough rerolls (the combined pool is sampled).
	local sawW, sawM = false, false
	local t = newState(0x5151, 2, 0)
	for _ = 1, 50 do
		Shop.generateOffers(t)
		for _, o in t.shop.offers do
			if o.kind == Shop.OfferKind.Weapon then
				sawW = true
			else
				sawM = true
			end
		end
