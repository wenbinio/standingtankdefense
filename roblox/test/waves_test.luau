-- ============================ harness ============================

local passed, failed = 0, 0
local firstFailures = {}

local function check(name, cond, detail)
	if cond then
		passed += 1
	else
		failed += 1
		if #firstFailures < 25 then
			table.insert(firstFailures, name .. (detail and (" — " .. detail) or ""))
		end
	end
end

local function eqNum(name, got, want)
	check(name, got == want, string.format("got %s, want %s", tostring(got), tostring(want)))
end

-- ============================ input ============================

-- The real catalog. `Content.luau` self-loads its embedded `content.json`, so
-- the core of this test needs no argv at all.
local Content = require("../src/shared/Content")
Waves.setContent(Content)
Shop.setContent(Content)

-- Optional argv: the oracle dump (see the header) widens the sweep. Any other
-- JSON document handed in is ignored.
local oracleDoc = nil
local text = table.concat({ ... }, "")
if #text > 0 then
	for _, d in Json.decodeMany(text) do
		if type(d) == "table" and d.hp_mult ~= nil then
			oracleDoc = d
		end
	end
end

local STEAM = Content.TIMELINE.steam
local BOSS_SPAWN_TICK = STEAM.boss_spawn_tick
local RAMP_INTERVAL = STEAM.ramp_interval
local GENTLE_TICKS = STEAM.gentle_ticks
local EARLY_GRUNT_CADENCE = Content.CONSTANTS.early_grunt_cadence
local BOSS = Content.BOSS

--- `Purpose` (`ids.rs`) — values are stable on the wire/checksum.
local PURPOSE = { Spawn = 0, Targeting = 1, Shop = 2, Reroll = 3, Proc = 4 }

--- The subset of `ArenaState` these two modules read or write. `next_entity_id`
--- starts at 2 because `ArenaState::new` allocates id 1 for the starting Bow.
local function newState(seed, pid)
	return {
		tick = 0,
		enemies = {},
		next_entity_id = 2,
		shop = { offers = {}, shop_seq = 0 },
		economy = { gold = 500, rerolls_remaining = 5, reroll_cost = 100 },
		pending_perk = nil,
		rng_spawn = Rng.derive(seed, pid, PURPOSE.Spawn, 0),
		rng_shop = Rng.derive(seed, pid, PURPOSE.Shop, 0),
		rng_reroll = Rng.derive(seed, pid, PURPOSE.Reroll, 0),
	}
end

local function rngHex(r)
	return string.sub(Rng.toHex(Rng.state(r)), 3) -- drop the "0x"
end

--- One tick of phase 5 in isolation, with the enemy list cleared first (which
--- is exactly what the oracle binary does), so `s.enemies` afterwards is this
--- tick's spawn list.
local function spawnAt(s, tick)
	s.tick = tick
	table.clear(s.enemies)
	Waves.spawn(s)
end

-- ============================ 1. enemy_hp_mult ============================

for _, e in ORACLE_HP_MULT do
	local tick, want = e[1], e[2]
	eqNum("hp_mult@" .. tick, Fixed.raw(Waves.enemyHpMult(tick)), want)
end

if oracleDoc ~= nil then
	for _, e in oracleDoc.hp_mult do
		eqNum("hp_mult(dump)@" .. e.tick, Fixed.raw(Waves.enemyHpMult(e.tick)), e.raw)
	end
end

-- The curve's SHAPE, transcribed from `waves.rs::hp_curve_is_a_3min_stepped_ramp`.
do
	eqNum("ramp interval is 5400 (steam)", RAMP_INTERVAL, 5400)
	check("m(0) == ONE", Fixed.eq(Waves.enemyHpMult(0), Fixed.ONE))

	-- (1) Monotonic non-decreasing across the whole curve (no downward steps).
	local prev = Fixed.ONE
	local dipped = nil
	local t = 0
	while t <= BOSS_SPAWN_TICK + 600 do
		local cur = Waves.enemyHpMult(t)
		if Fixed.lt(cur, prev) and dipped == nil then
			dipped = t
		end
		prev = cur
		t += 30 -- sample once per second — fast and dense enough
	end
	check("curve never dips", dipped == nil, dipped and ("dipped at tick " .. dipped) or nil)

	-- (2) Exact post-step multipliers at each 3-min boundary (×10000),
	--     compounding ×1.1872 per interval up to ≈ ×5.56 at the boss.
	local post = {
		{ 0, 10000 },
		{ 5400, 11871 },
		{ 10800, 14093 },
		{ 16200, 16731 },
		{ 21600, 19862 },
		{ 27000, 23580 },
		{ 32400, 27993 },
		{ 37800, 33232 },
		{ 43200, 39452 },
		{ 48600, 46837 },
		{ 54000, 55604 }, -- the 30-min boss tier — the ≈ ×5.56 endpoint.
	}
	for _, p in post do
		eqNum(
			"post-step mult at " .. p[1],
			Fixed.toInt(Fixed.scaleI64(Waves.enemyHpMult(p[1]), 10000)),
			p[2]
		)
	end
	-- The boss phase HOLDS the endpoint `base(10)`.
	check(
		"boss phase holds the endpoint",
		Fixed.eq(Waves.enemyHpMult(BOSS_SPAWN_TICK + 5000), Waves.enemyHpMult(BOSS_SPAWN_TICK))
	)

	-- (3) Within an interval: a gentle region, then a STEEPER warning region.
	local lo = 5400
	local warnStart = lo + GENTLE_TICKS -- 9900
	local function m10e6(x)
		return Fixed.toInt(Fixed.scaleI64(Waves.enemyHpMult(x), 1000000))
	end
	local gentleSlope = (m10e6(warnStart - 100) - m10e6(warnStart - 200)) // 100
	local warnSlope = (m10e6(warnStart + 100) - m10e6(warnStart)) // 100
	check("gentle region must rise", gentleSlope > 0)
	check("warning slope perceptibly steeper", warnSlope >= gentleSlope * 3)

	-- (4) The boundary STEP dwarfs any single warning tick, and is exactly ×1.14.
	local preStep = Waves.enemyHpMult(lo + RAMP_INTERVAL - 1)
	local postStep = Waves.enemyHpMult(lo + RAMP_INTERVAL)
	local step = m10e6(lo + RAMP_INTERVAL) - m10e6(lo + RAMP_INTERVAL - 1)
	check("boundary step dwarfs a warning tick", step > warnSlope * 50)
	eqNum(
		"boundary step is +14% (J)",
		Fixed.toInt(Fixed.scaleI64(postStep, 1000)),
		Fixed.toInt(Fixed.scaleI64(Fixed.mul(preStep, Fixed.fromRatio(57, 50)), 1000))
	)
end

