	eqNum("roblox ramp interval", rbx.ramp_interval, 900)
	eqNum(
		"roblox curve reaches the SAME endpoint (rescale, not rebalance)",
		Fixed.toInt(Fixed.scaleI64(Waves.enemyHpMult(rbx.boss_spawn_tick, rbx), 10000)),
		Fixed.toInt(Fixed.scaleI64(Waves.enemyHpMult(BOSS_SPAWN_TICK, STEAM), 10000))
	)
	check(
		"default timeline is steam (the oracle's)",
		Fixed.eq(Waves.enemyHpMult(9000), Waves.enemyHpMult(9000, STEAM))
	)
end

-- ============================ 2. spawn, vs the oracle ============================

local function runSpawnOracle(run, label)
	local s = newState(run.seed, run.pid)
	-- Fast-forward honestly: `rng_spawn`'s state after tick N depends on every
	-- preceding tick, so there is no shortcut.
	for t = 0, run.start - 1 do
		spawnAt(s, t)
	end
	for i, want in run.ticks do
		local tick = run.start + i - 1
		spawnAt(s, tick)
		local tag = string.format("%s t=%d", label, tick)
		local gotHex = rngHex(s.rng_spawn)
		if gotHex ~= want[1] then
			check(tag .. " rng_spawn", false, "got " .. gotHex .. ", want " .. want[1])
			return -- once the stream diverges every later tick is noise
		end
		passed += 1
		eqNum(tag .. " next_entity_id", s.next_entity_id, want[2])
		local n = (#want - 2) // 3
		eqNum(tag .. " spawn count", #s.enemies, n)
		for k = 1, math.min(n, #s.enemies) do
			local e = s.enemies[k]
			eqNum(tag .. " spawn" .. k .. ".id", e.id, want[2 + (k - 1) * 3 + 1])
			eqNum(tag .. " spawn" .. k .. ".def", e.def, want[2 + (k - 1) * 3 + 2])
			eqNum(tag .. " spawn" .. k .. ".hp", e.hp, want[2 + (k - 1) * 3 + 3])
		end
	end
end

for i, run in ORACLE_SPAWN do
	runSpawnOracle(run, "spawn#" .. i)
end

if oracleDoc ~= nil then
	-- The dump's entries are contiguous runs keyed by (seed, pid, tick); replay
	-- each contiguous block.
	local blocks = {}
	local cur = nil
	for _, e in oracleDoc.spawn do
		if cur == nil or cur.seed ~= e.seed or cur.pid ~= e.pid or cur.next ~= e.tick then
			cur = { seed = e.seed, pid = e.pid, start = e.tick, next = e.tick, ticks = {} }
			table.insert(blocks, cur)
		end
		local row = { e.rng_spawn, e.next_entity_id }
		for _, sp in e.spawns do
			table.insert(row, sp.id)
			table.insert(row, sp.def)
			table.insert(row, sp.hp)
		end
		table.insert(cur.ticks, row)
		cur.next = e.tick + 1
	end
	for i, b in blocks do
		runSpawnOracle(b, "dump#" .. i)
	end
end

