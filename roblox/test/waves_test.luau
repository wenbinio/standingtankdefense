-- ============================ 5b. the rarity ladder (shop.rs) ============================
-- Properties of `shop::rarity_weights` and the two-stage draw. These are
-- properties, not pinned numbers: the exact draws are pinned by the ORACLE_SHOP
-- rows above (which cover rounds 0 / 20 / 40 / 60), and the anchor tables are
-- Rust code, so a retune must show up there rather than in a second copy here.
do
	local TIERS = Shop.TIERS
	local WEIGHT_TOTAL = Shop.WEIGHT_TOTAL
	-- `shop.rs`: `WEIGHT_TOTAL = 1000 * ESCALATION_ROUNDS` (both anchor tables sum
	-- to 1000 per-mille), so the ramp length is recoverable from the one constant
	-- the module exports — no second copy of it to go stale.
	local ESCALATION_ROUNDS = WEIGHT_TOTAL // 1000

	-- (1) Every round's table sums to the CONSTANT total — that is what keeps the
	--     tier `below` bound state-independent (one bound, every slot, every round).
	local badSum = nil
	for _, round in { 0, 1, 7, 20, 39, 40, 41, 100, 59999, U32_MAX } do
		local w = Shop.rarityWeights(round)
		local sum = 0
		for t = 0, TIERS - 1 do
			sum += w[t]
		end
		if sum ~= WEIGHT_TOTAL and badSum == nil then
			badSum = round
		end
	end
	check("weights always sum to the constant total", badSum == nil,
		badSum and ("round " .. badSum) or nil)

	-- (2) Monotone across the whole ramp: Common only falls, Epic only rises.
	local prev = Shop.rarityWeights(0)
	local commonRose, epicFell = nil, nil
	for round = 1, ESCALATION_ROUNDS + 5 do
		local w = Shop.rarityWeights(round)
		if w[0] > prev[0] and commonRose == nil then
			commonRose = round
		end
		if w[TIERS - 1] < prev[TIERS - 1] and epicFell == nil then
			epicFell = round
		end
		prev = w
	end
	check("common never rises with round", commonRose == nil,
		commonRose and ("rose at round " .. commonRose) or nil)
	check("epic never falls with round", epicFell == nil,
		epicFell and ("fell at round " .. epicFell) or nil)

	-- (3) The ramp ends: past `ESCALATION_ROUNDS` the table stops moving, and the
	--     opening table is materially different from the late one.
	local plateauA = Shop.rarityWeights(ESCALATION_ROUNDS)
	local plateauB = Shop.rarityWeights(U32_MAX - 1)
	local plateauSame = true
	for t = 0, TIERS - 1 do
		if plateauA[t] ~= plateauB[t] then
			plateauSame = false
		end
	end
	check("the escalation plateaus after the ramp", plateauSame)
	local early = Shop.rarityWeights(0)
	check("common is the backdrop early", early[0] > early[TIERS - 1] * 5)
	check("epic is what a late shop is about", plateauA[TIERS - 1] > early[TIERS - 1] * 5)

	-- (4) The pre-first-round sentinel (`ArenaState::new`'s `u32::MAX`) uses the
	--     OPENING table, not the endgame one.
	local sentinel = Shop.rarityWeights(U32_MAX)
	local sentinelIsEarly = true
	for t = 0, TIERS - 1 do
		if sentinel[t] ~= early[t] then
			sentinelIsEarly = false
		end
	end
	check("the pre-round sentinel uses the opening table", sentinelIsEarly)
	-- …and end to end: a shop generated at the sentinel round is byte-identical
	-- to one generated at round 0, offers and cursor alike.
	local sa = newState(0x1BADB002, 0, U32_MAX)
	local sb = newState(0x1BADB002, 0, 0)
	Shop.generateOffers(sa)
	Shop.generateOffers(sb)
	local sentinelSame = rngHex(sa.rng_shop) == rngHex(sb.rng_shop)
	for k = 1, Shop.OFFER_SLOTS do
		if sa.shop.offers[k].def ~= sb.shop.offers[k].def
			or sa.shop.offers[k].kind ~= sb.shop.offers[k].kind
		then
			sentinelSame = false
		end
	end
	check("a sentinel-round shop equals a round-0 shop", sentinelSame)

	-- (5) All four tiers are actually servable by BOTH catalogs. If a catalog
	--     loses a tier the RNG-free fallback silently flattens the ladder, and the
	--     designed escalation quietly stops existing.
	for _, pair in { { "weapons", Content.WEAPONS }, { "modifiers", Content.MODIFIERS } } do
		local counts = {}
		for t = 0, TIERS - 1 do
			counts[t] = 0
		end
		local total = 0
		for _, e in (pair[2] :: any) do
			if e.rarity >= 0 and e.rarity < TIERS then
				counts[e.rarity] += 1
			end
			total += 1
		end
		local sum = 0
		for t = 0, TIERS - 1 do
			check(
				"catalog serves rarity " .. t .. " (" .. (pair[1] :: any) .. ")",
				counts[t] > 0,
				"no entries of rarity " .. t
			)
			sum += counts[t]
		end
		eqNum("every " .. (pair[1] :: any) .. " entry has a ladder rarity", sum, total)
	end

	-- (6) The escalation is OBSERVABLE in the offers, not just in the table: over
	--     enough shops, a late round offers strictly more Epic and strictly less
	--     Common than the opening round (same seed, so this is the weighting).
	local function histogram(seed, round, shops)
		local h = { [0] = 0, 0, 0, 0 }
		local st = newState(seed, 0, round)
		for _ = 1, shops do
			Shop.generateOffers(st)
			for _, o in st.shop.offers do
				local cat = if o.kind == Shop.OfferKind.Weapon then Content.WEAPONS else Content.MODIFIERS
				local r = cat[o.def + 1].rarity
				h[r] += 1
			end
		end
		return h
	end
	local hEarly = histogram(0xC0FFEE, 0, 500)
	local hMid = histogram(0xC0FFEE, ESCALATION_ROUNDS // 2, 500)
	local hLate = histogram(0xC0FFEE, ESCALATION_ROUNDS, 500)
	local totalEarly = hEarly[0] + hEarly[1] + hEarly[2] + hEarly[3]
	check("early shops are mostly common", hEarly[0] * 100 // totalEarly >= 50,
		"common share " .. (hEarly[0] * 100 // totalEarly) .. "%")
	check("epic is an event early, not furniture", hEarly[3] * 100 // totalEarly <= 5)
	check("…but epic is reachable early", hEarly[3] > 0)
	check("epic escalates early -> late", hLate[3] > hEarly[3] * 5,
		hEarly[3] .. " -> " .. hLate[3])
	check("common recedes early -> late", hEarly[0] > hLate[0] * 2,
		hEarly[0] .. " -> " .. hLate[0])
	check("mid-run sits strictly between the ends",
		hEarly[3] < hMid[3] and hMid[3] < hLate[3],
		hEarly[3] .. " / " .. hMid[3] .. " / " .. hLate[3])
	check("a late shop is high-rarity overall", hLate[2] + hLate[3] > hLate[0] + hLate[1])
end

-- ============================ 6. RNG stream discipline (§S4) ============================

do
	local s = newState(0xDEADBEEF, 0, 0)
	local rerollBefore = rngHex(s.rng_reroll)
	local spawnBefore = rngHex(s.rng_spawn)
	for _ = 1, 20 do
		Shop.generateOffers(s)
	end
	-- `rng_reroll` is derived and checksummed but NEVER drawn from anywhere in
	-- the Rust sim: reroll cost escalation is pure arithmetic. Any draw here
	-- would desynchronize the checksum on the very first reroll.
	check("generateOffers never touches rng_reroll", rngHex(s.rng_reroll) == rerollBefore)
	check("generateOffers never touches rng_spawn", rngHex(s.rng_spawn) == spawnBefore)

	local w = newState(0xDEADBEEF, 0, 0)
	local shopBefore = rngHex(w.rng_shop)
	for t = 0, 200 do
		spawnAt(w, t)
	end
	check("Waves.spawn never touches rng_shop", rngHex(w.rng_shop) == shopBefore)

	-- `generate_offers` performs EXACTLY `2 * OFFER_SLOTS` draws, in slot order,
	-- unconditionally: a tier roll then a member roll. The count is a pure
	-- function of state, never of the values rolled — so the same round must
	-- always land on the same cursor regardless of which tiers came up.
	local cursorSame = true
	for _, round in { 0, 20, 40 } do
		local p = newState(0x0FF1CE, 4, round)
		local q = newState(0x0FF1CE, 4, round)
		Shop.generateOffers(p)
		Shop.generateOffers(q)
		if rngHex(p.rng_shop) ~= rngHex(q.rng_shop) then
			cursorSame = false
		end
	end
	check("the offer draw sequence is a pure function of state", cursorSame)

	-- The boss spawn itself draws NOTHING (it uses SPAWN_RING[0] directly), so
	-- the escort's ring picks at the boss tick land on the same words they would
	-- have had without a boss. Verified against the boss-tick oracle rows above;
	-- restated here as an explicit count: boss tick spawns == escort entries that
	-- fire, PLUS one for the boss.
	local function gcd(a, b)
		while b ~= 0 do
			a, b = b, a % b
		end
		return a
	end
	local escortLcm = 1
	for _, ws in Content.BOSS_ESCORT do
		escortLcm = escortLcm * ws.cadence_ticks // gcd(escortLcm, ws.cadence_ticks)
	end
	local later = BOSS_SPAWN_TICK + escortLcm -- every escort entry fires here
	local b1 = newState(0x12345678, 0, 0)
	local b2 = newState(0x12345678, 0, 0)
	spawnAt(b1, BOSS_SPAWN_TICK)
	spawnAt(b2, later)
	local fires = 0
	for _, ws in Content.BOSS_ESCORT do
		if ws.cadence_ticks ~= 0 and BOSS_SPAWN_TICK % ws.cadence_ticks == 0 then
			fires += 1
		end
	end
	local firesLater = 0
	for _, ws in Content.BOSS_ESCORT do
		if ws.cadence_ticks ~= 0 and later % ws.cadence_ticks == 0 then
			firesLater += 1
		end
	end
	eqNum("every escort entry fires at the lcm tick", firesLater, #Content.BOSS_ESCORT)
	eqNum("boss tick spawns = boss + escort entries that fire", #b1.enemies, fires + 1)
	eqNum("escort-only tick spawns = escort entries that fire", #b2.enemies, firesLater)
end

-- ============================ 7. reroll: stream advances once per success ============================
-- LOCAL MIRROR of `input.rs::apply(Input::Reroll)`. `Input.luau` owns this;
-- it is reproduced here only to test the property `Shop.luau` owns.
do
	local REROLL_COST_STEP = 100

	local function reroll(s)
		if s.economy.rerolls_remaining > 0 then
			s.economy.rerolls_remaining -= 1
			Shop.generateOffers(s)
		elseif s.economy.gold >= s.economy.reroll_cost then
			s.economy.gold -= s.economy.reroll_cost
			Shop.generateOffers(s)
			s.economy.reroll_cost += REROLL_COST_STEP
		end
	end

	local s = newState(0xDEADBEEF, 0, 0)
	s.economy.gold = 1000
	eqNum("starting free rerolls", s.economy.rerolls_remaining, 5)
	eqNum("starting reroll cost", s.economy.reroll_cost, 100)

	-- Free rerolls first: no gold charged, cost unchanged, one generation each.
	for i = 1, 5 do
		reroll(s)
		eqNum("free reroll " .. i .. ": rerolls_remaining", s.economy.rerolls_remaining, 5 - i)
		eqNum("free reroll " .. i .. ": gold unchanged", s.economy.gold, 1000)
		eqNum("free reroll " .. i .. ": cost unchanged", s.economy.reroll_cost, 100)
		eqNum("free reroll " .. i .. ": one generation", s.shop.shop_seq, i)
	end

	-- Then escalating gold: 100, 200, ...
	reroll(s)
	eqNum("paid reroll 1: gold", s.economy.gold, 900)
	eqNum("paid reroll 1: cost escalates", s.economy.reroll_cost, 200)
	reroll(s)
	eqNum("paid reroll 2: gold", s.economy.gold, 700)
	eqNum("paid reroll 2: cost escalates", s.economy.reroll_cost, 300)
	eqNum("seven generations so far", s.shop.shop_seq, 7)

	-- Broke and out of free rerolls → IGNORED. The stream must not advance:
	-- this is the save-scum guard — a rejected reroll may not consume words.
	s.economy.gold = 50
	local frozen = rngHex(s.rng_shop)
	local seq = s.shop.shop_seq
	local firstDef = s.shop.offers[1].def
	reroll(s)
	eqNum("ignored reroll: gold unchanged", s.economy.gold, 50)
	eqNum("ignored reroll: no regeneration", s.shop.shop_seq, seq)
	eqNum("ignored reroll: offers unchanged", s.shop.offers[1].def, firstDef)
	check("ignored reroll: rng_shop frozen", rngHex(s.rng_shop) == frozen)

	-- The 7 generations the reroll path produced are exactly generations 1..7 of
	-- the plain offer stream — rerolling is not a different stream.
	local plain = newState(0xDEADBEEF, 0, 0)
	local same = true
	for _ = 1, 7 do
		Shop.generateOffers(plain)
	end
	if rngHex(plain.rng_shop) ~= rngHex(s.rng_shop) then
		same = false
	end
	for k = 1, 8 do
		if plain.shop.offers[k].def ~= s.shop.offers[k].def then
			same = false
		end
	end
	check("reroll advances the SAME offer stream, once per success", same)
end

-- ============================ 8. the stateful offer machinery ============================
do
	-- `docs/02` §2.8 says the offer stream is stateful and order-dependent so it
	-- cannot be save-scummed. In the IMPLEMENTED Rust that property holds in a
	-- specific, narrower way: the stream is advanced ONLY by `generate_offers`,
	-- and `pending_perk` (Multiplication Gems / Black Market voucher) changes the
	-- next matching PURCHASE — free, or +N free copies — not the next DRAW.
	-- The draw IS rarity-weighted now (`docs/11` §11.2), but only by `s.round`;
	-- pinning that here so a future pool-restricted or perk-sensitive draw is a
	-- deliberate, visible break rather than a silent one.
	local a = newState(777, 1, 3)
	local b = newState(777, 1, 3)
	for i = 1, 6 do
		Shop.generateOffers(a)
		-- Arm, match and consume perks, move gold around, buy things — none of it
		-- may perturb the offer stream.
		b.pending_perk = { rarity = (i % 3 == 0) and 255 or 0, extra_copies = i, free = i % 2 == 0 }
		b.economy.gold += 137 * i
		Shop.generateOffers(b)
		b.pending_perk = nil
	end
	local same = rngHex(a.rng_shop) == rngHex(b.rng_shop)
	for k = 1, 8 do
		if a.shop.offers[k].def ~= b.shop.offers[k].def or a.shop.offers[k].kind ~= b.shop.offers[k].kind then
			same = false
		end
	end
	check("offer stream is advanced ONLY by generateOffers", same)

	-- The catalog carries the meta items the perk machine needs (`state.rs`
	-- `buy_modifier`: tag 24 GrantDuplicator(rarity, copies), 25 GrantVoucher
	-- (rarity), 26 GrantGold). `input.rs` reads them; assert they exist so a
	-- content change that drops them fails here rather than silently.
	local dup, voucher, gold = nil, nil, nil
	for i, m in Content.MODIFIERS do
		for _, e in m.effects do
			if e.tag == 24 and dup == nil then
				dup = { idx = i - 1, rarity = e.a, copies = e.b }
			elseif e.tag == 25 and voucher == nil then
				voucher = { idx = i - 1, rarity = e.a }
			elseif e.tag == 26 and gold == nil then
				gold = { idx = i - 1, amount = e.a }
			end
		end
	end
	check("catalog has a Multiplication-Gems style duplicator", dup ~= nil)
	check("catalog has a Black-Market style voucher", voucher ~= nil)
	check("catalog has a Magic-Treasure style gold grant", gold ~= nil)
	if dup ~= nil then
		check("duplicator grants at least one extra copy", (dup :: any).copies >= 1)
	end
end

-- ============================ 9. catalog index base ============================
do
	-- `Content.luau`'s index base is not pinned by SIM-SPEC §S2, and getting it
	-- wrong is silent and fatal: a member roll over a 0-based table would draw
	-- from the wrong count and desynchronize `rng_shop` forever. Both modules
	-- detect the base and cross-check it against `constants.num_*`; prove the
	-- adaptation is behavior-NEUTRAL by running both wirings.
	local function toZeroBased(t)
		local out = {}
		for i, v in t do
			out[i - 1] = v
		end
		return out
	end
	local Zero = {}
	for k, v in Content do
		Zero[k] = v
	end
	Zero.WEAPONS = toZeroBased(Content.WEAPONS)
	Zero.MODIFIERS = toZeroBased(Content.MODIFIERS)
	Zero.ENEMIES = toZeroBased(Content.ENEMIES)
	Zero.SPAWN_RING = toZeroBased(Content.SPAWN_RING)
	Zero.WAVE_M0 = toZeroBased(Content.WAVE_M0)
	Zero.BOSS_ESCORT = toZeroBased(Content.BOSS_ESCORT)

	local one = newState(0xDEADBEEF, 0, 0)
	Shop.generateOffers(one)
	local oneW = newState(0x12345678, 0, 0)
	for t = 0, 120 do
		spawnAt(oneW, t)
	end

	Shop.setContent(Zero)
	Waves.setContent(Zero)
	local zero = newState(0xDEADBEEF, 0, 0)
	Shop.generateOffers(zero)
	local zeroW = newState(0x12345678, 0, 0)
	for t = 0, 120 do
		spawnAt(zeroW, t)
	end

	check("0-based catalog: same rng_shop", rngHex(zero.rng_shop) == rngHex(one.rng_shop))
	local same = true
	for k = 1, 8 do
		if zero.shop.offers[k].def ~= one.shop.offers[k].def
			or zero.shop.offers[k].cost ~= one.shop.offers[k].cost
		then
			same = false
		end
	end
	check("0-based catalog: same offers", same)
	check("0-based catalog: same rng_spawn", rngHex(zeroW.rng_spawn) == rngHex(oneW.rng_spawn))
	eqNum("0-based catalog: same spawn count", #zeroW.enemies, #oneW.enemies)
	local sameSpawn = #zeroW.enemies == #oneW.enemies
	for k = 1, math.min(#zeroW.enemies, #oneW.enemies) do
		if zeroW.enemies[k].def ~= oneW.enemies[k].def or zeroW.enemies[k].hp ~= oneW.enemies[k].hp then
			sameSpawn = false
		end
	end
	check("0-based catalog: same spawns", sameSpawn)

	-- A catalog whose length disagrees with `constants.num_*` must fail LOUDLY,
	-- not draw over the wrong range.
	local Bad = {}
	for k, v in Content do
		Bad[k] = v
	end
	local truncated = {}
	for i = 1, #Content.WEAPONS - 1 do
		truncated[i] = Content.WEAPONS[i]
	end
	Bad.WEAPONS = truncated
	Shop.setContent(Bad)
	local ok = pcall(function()
		Shop.generateOffers(newState(1, 0, 0))
	end)
	check("a catalog/num_* mismatch errors instead of desyncing", not ok)

	Shop.setContent(Content)
	Waves.setContent(Content)
end

-- ============================ report ============================

print(string.format("waves_test: %d passed, %d failed", passed, failed))
if failed > 0 then
	for _, f in firstFailures do
		print("  FAIL " .. f)
	end
	error("waves_test: " .. failed .. " assertion(s) failed", 0)
end
