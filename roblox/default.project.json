{
  "name": "StandingTankDefense",
  "globIgnorePaths": ["**/*.md", "**/.DS_Store"],
  "tree": {
    "$className": "DataModel",

    "ReplicatedStorage": {
      "$className": "ReplicatedStorage",
      "Shared": {
        "$path": "dist/shared"
      }
    },

    "ServerScriptService": {
      "$className": "ServerScriptService",
      "Server": {
        "$path": { "optional": "dist/server" }
      },
      "Bench": {
        "$path": "bench"
      }
    },

    "ServerStorage": {
      "$className": "ServerStorage",
      "Test": {
        "$path": { "optional": "test" }
      }
    },

    "StarterPlayer": {
      "$className": "StarterPlayer",
      "StarterPlayerScripts": {
        "$className": "StarterPlayerScripts",
        "Client": {
          "$path": { "optional": "dist/client" }
        }
      }
    },

    "Workspace": {
      "$className": "Workspace",
      "$properties": {
        "StreamingEnabled": false
      }
    },

    "Lighting": {
      "$className": "Lighting"
    }
  }
}
